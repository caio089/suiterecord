# ========== FRONTEND (Vite — Render Static ou Vercel) ==========
# Embutidas no BUILD. Na Vercel: Project → Settings → Environment Variables.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_GOOGLE_CLIENT_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"

# URL da API worker (vazio = mesmo origin, modo local monolítico)
# Render:  https://suiterecord.onrender.com
# Fly.io:  https://suiter-record.fly.dev
# Vercel NÃO hospeda a API de transcrição longa — aponte para o worker.
VITE_API_URL=""

# ========== BACKEND / API WORKER (Render ou Fly.io) ==========
GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY"

# URL do frontend (CORS + OAuth postMessage)
# Local:   http://localhost:3000
# Render:  https://suiterecord-1.onrender.com
# Vercel:  https://seu-app.vercel.app
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# URL pública da API (redirect OAuth Google Agenda)
# API_PUBLIC_URL="https://suiterecord.onrender.com"

API_GOOGLE_CALENDAR_TOKEN="YOUR_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_CLIENT_SECRET"

# API_ONLY=true  → só API (sem servir dist/) — Render Web Service / Fly
# NODE_ENV=production

# Opcional: service role só no worker (nunca no frontend) — próxima etapa jobs Postgres
# SUPABASE_SERVICE_ROLE_KEY=""
