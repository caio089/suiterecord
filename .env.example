# ========== FRONTEND (Vite — Vercel) ==========
# Embutidas no BUILD. Vercel → Project → Settings → Environment Variables.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_GOOGLE_CLIENT_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"

# Deixe vazio na Vercel (front + API no mesmo domínio). Só use se a API for externa.
VITE_API_URL=""

# ========== BACKEND (função serverless /api na Vercel) ==========
GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY"

# Supabase server-side (service role — NUNCA com prefixo VITE_).
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# URL do app (CORS + OAuth postMessage)
# Local: http://localhost:3000
# Vercel: https://seu-app.vercel.app
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# OAuth Google — redirect na mesma URL da Vercel:
# https://seu-app.vercel.app/api/google/oauth/callback
# (VERCEL_URL é detectada automaticamente; use API_PUBLIC_URL só com domínio customizado)

API_GOOGLE_CALENDAR_TOKEN="YOUR_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_CLIENT_SECRET"
