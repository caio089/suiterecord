# ========== FRONTEND (Vite / Static Site) ==========
# Embutidas no build — no Render Static, defina antes do build.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_GOOGLE_CLIENT_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"

# URL da API (vazio = mesmo origin, modo local monolítico)
# Produção Render: https://suiterecord-api.onrender.com
VITE_API_URL=""

# ========== BACKEND (Web Service) ==========
GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY"

# URL do frontend static (CORS + OAuth postMessage)
# Local: http://localhost:3000
# Render: https://suiterecord-web.onrender.com
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# URL pública da API (redirect OAuth). No Render costuma vir de RENDER_EXTERNAL_URL.
# API_PUBLIC_URL="https://suiterecord-api.onrender.com"

API_GOOGLE_CALENDAR_TOKEN="YOUR_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_CLIENT_SECRET"
# Alias legado (mesmo valor do secret):
# SECRET_GOOGLE_CLIENT_ID="YOUR_CLIENT_SECRET"

# API_ONLY=true  → só API (sem servir dist/) — usado no Render Web Service
# NODE_ENV=production
