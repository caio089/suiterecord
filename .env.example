# ========== FRONTEND (Vite — Vercel) ==========
# Embutidas no BUILD. Vercel → Project → Settings → Environment Variables.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_GOOGLE_CLIENT_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"

# Deixe vazio na Vercel (front + API no mesmo domínio). Só use se a API for externa.
VITE_API_URL=""

# ========== BACKEND (função serverless /api na Vercel) ==========
GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY"

# Supabase server-side (service role — NUNCA com prefixo VITE_).
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_PROJECT_REF="YOUR_PROJECT_REF"
SUPABASE_ACCESS_TOKEN="YOUR_PERSONAL_MANAGEMENT_TOKEN_FOR_MIGRATIONS"

# Fila durável de transcrição (Upstash QStash)
QSTASH_TOKEN="YOUR_QSTASH_TOKEN"
TRANSCRIPTION_WORKER_SECRET="GENERATE_A_LONG_RANDOM_SECRET"

# Hosts HTTPS autorizados para webhooks de integrações
INTEGRATION_ALLOWED_HOSTS="hooks.example.com,api.partner.example"
INTEGRATION_WEBHOOK_ENABLED="false"
INTEGRATION_WEBHOOK_URL="https://hooks.example.com/alfredo"
INTEGRATION_WEBHOOK_TOKEN="SERVER_SIDE_ONLY"

# URL do app (CORS + OAuth postMessage)
# Local: http://localhost:3000
# Vercel: https://seu-app.vercel.app
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# OAuth Google — redirect na mesma URL da Vercel:
# https://seu-app.vercel.app/api/google/oauth/callback
# (VERCEL_URL é detectada automaticamente; use API_PUBLIC_URL só com domínio customizado)

API_GOOGLE_CALENDAR_TOKEN="YOUR_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_CLIENT_SECRET"
GOOGLE_OAUTH_STATE_SECRET="GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET"
